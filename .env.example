# PrivacySEK Platform Configuration

# Server Ports
PORT=3001
SCANNER_PORT=3001

# MongoDB Local Connection
# Connects to the local MongoDB server (which can also be inspected via MongoDB Compass)
MONGODB_URI=mongodb://127.0.0.1:27017/privacysek
MONGODB_DB_NAME=privacysek

# Frontend API URL (leave empty for Vite proxy in development)
VITE_SCANNER_API_URL=
