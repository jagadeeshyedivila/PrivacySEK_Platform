# PrivacySEK Platform Configuration

# Server Ports
PORT=3001
SCANNER_PORT=3001

# MongoDB: the only place the app decides which database it uses.
# Local:   MONGODB_URI=mongodb://127.0.0.1:27017
# Cluster: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Keep dev and production apart by name, e.g. privacysek_dev / privacysek
MONGODB_DB_NAME=privacysek

# On each server start, insert any demo record that is missing (new database, or records
# a user deleted). Default true. Set to false to leave the database as it is.
SEED_DEMO_DATA=true

# Only for `npm run db:copy` (copying one database into another).
# Source defaults to MONGODB_URI / MONGODB_DB_NAME above.
# SOURCE_MONGODB_URI=
# SOURCE_DB_NAME=
# TARGET_MONGODB_URI=
# TARGET_DB_NAME=

# Frontend API URL (leave empty for Vite proxy in development).
# Read at build time: set it before `npm run build`. Never put MongoDB credentials in a VITE_ variable.
VITE_SCANNER_API_URL=
